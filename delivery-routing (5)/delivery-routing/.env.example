# Copy to .env and edit:  cp .env.example .env

# --- Where all data lives on the host (outside Docker) ---
# Put one or more .osm.pbf regions in  $DR_DATA_DIR/osm/  and run ./scripts/setup.sh
# Contents: osm/ work/ osrm/ tiles/ tiles-sources/ tmp/ postgres/
DR_DATA_DIR=./data                    # e.g. /srv/delivery-routing-data

DR_OSRM_PROFILE=car                   # car | bicycle | foot  (setup rebuilds when changed)
DR_FORCE_REBUILD=0                    # 1 = rebuild everything on the next setup run
DR_TILES_JAVA_MEM=6g                  # RAM for the tile build (more regions -> more RAM)
DR_GEOCODE=1                          # 1 = build address search (picker suggestions); 0 = skip
DR_GEO_CACHE_MB=2000                  # RAM for the address search import

# --- Routing database (separate from Airflow's Postgres) ---
DR_DB_NAME=dr_routing
DR_DB_USER=dr_routing_user
DR_DB_PASSWORD=change-me-strong-password
DR_DB_PORT=5442
DR_SAVE_ROUTES=1                      # 0 = don't store routes

# --- Ports ---
DR_WEB_PORT=8088                      # map pages
DR_API_PORT=8001                      # routing API (localhost only)
DR_OSRM_PORT=5005                     # raw OSRM (localhost only)

# --- Pickup / delivery confirmation ---
DR_COMPLETE_RADIUS_M=250              # rider must be within this many metres of pickup / customer
DR_COMPLETE_REQUIRE_LOCATION=0        # 1 = refuse to confirm if the rider's position is unknown

# --- Browser access ---
# Sites allowed to call the API from the browser (address picker on your website).
# Comma-separated, e.g. https://shop.example.com,https://admin.example.com   (* = any)
DR_CORS_ORIGINS=*

# Accepted coordinate area. setup.sh writes the real area of your regions to
# $DR_DATA_DIR/work/bbox.txt and the API uses that; this is only the fallback.
DR_BBOX=68.0,6.0,97.5,37.5

# DR_OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v5.27.1
